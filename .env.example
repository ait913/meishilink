# DB
DATABASE_URL="file:./dev.db"

# Auth.js v5
AUTH_SECRET="<openssl rand -base64 32 で生成>"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Magic Link (dev では console.log するため未設定でも動く)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="MeishiLink <no-reply@example.com>"

# E2E テスト用バイパス (本番では絶対 false)
AUTH_TEST_MODE="false"

# 公開URL (vCard URL/QR に焼き込む)
PUBLIC_BASE_URL="http://localhost:3000"

# アップロード保存先 (絶対 or プロジェクト相対)
UPLOAD_DIR="./storage/uploads"

