  "private": true,
  "description": "日本向け Web 名刺共有・管理アプリ。閲覧は登録不要。登録ユーザーが自分の Web 名刺を作成し、QR で共有する。",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
