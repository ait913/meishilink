    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.2.4",
    "better-sqlite3": "^11.10.0",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "next": "^15.5.16",
    "next-auth": "5.0.0-beta.31",
    "nodemailer": "^7.0.7",
    "postcss": "^8.5.14",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-to-print": "^3.3.0",
    "resend": "^6.12.3",
    "tailwindcss": "^4.2.4",
    "zod": "^4.4.3"
